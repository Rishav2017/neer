#==============================================================================
# WEEK 3 ENVIRONMENT VARIABLES
#==============================================================================
# Add these to your .env file for Week 3 features

#------------------------------------------------------------------------------
# REDIS & QUEUE CONFIGURATION
#------------------------------------------------------------------------------
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

#------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY
#------------------------------------------------------------------------------
# Get these from https://dashboard.razorpay.com/app/keys
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

#------------------------------------------------------------------------------
# STRIPE (Alternative Payment Gateway)
#------------------------------------------------------------------------------
# PAYMENT_GATEWAY=stripe
# STRIPE_KEY=pk_test_xxxxxxxxxxxxx
# STRIPE_SECRET=sk_test_xxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

#------------------------------------------------------------------------------
# SMS CONFIGURATION (Optional - Placeholder)
#------------------------------------------------------------------------------
SMS_PROVIDER=twilio

# Twilio credentials
TWILIO_SID=ACxxxxxxxxxxxxx
TWILIO_TOKEN=xxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1234567890

# MSG91 credentials (alternative)
# MSG91_AUTH_KEY=xxxxxxxxxxxxxxxx
# MSG91_SENDER_ID=YOURID

#------------------------------------------------------------------------------
# HORIZON CONFIGURATION
#------------------------------------------------------------------------------
HORIZON_DOMAIN=
HORIZON_PATH=horizon
HORIZON_PREFIX=neer-horizon:

#==============================================================================
# SETUP INSTRUCTIONS
#==============================================================================
#
# 1. Copy these variables to your .env file
#
# 2. Install Redis:
#    - macOS: brew install redis && brew services start redis
#    - Ubuntu: sudo apt install redis-server && sudo systemctl start redis
#    - Docker: docker run -d -p 6379:6379 redis
#
# 3. Install Horizon:
#    composer require laravel/horizon
#    php artisan horizon:install
#
# 4. Run migrations:
#    php artisan migrate
#
# 5. Start Horizon (development):
#    php artisan horizon
#
# 6. For production, set up Supervisor:
#    See config/supervisor.conf.example
#
# 7. Set up Razorpay webhook:
#    - Go to Razorpay Dashboard > Settings > Webhooks
#    - Add webhook URL: https://your-domain.com/api/v1/payments/webhook
#    - Select events: payment.captured, payment.failed
#    - Copy the webhook secret to RAZORPAY_WEBHOOK_SECRET
#
#==============================================================================
